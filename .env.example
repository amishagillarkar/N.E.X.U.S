# =============================================================================
# NEXUS AI — Environment Configuration
# =============================================================================

# Server settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
RELOAD=false

# -----------------------------------------------------------------------------
# LLM Provider Options (Choose ONE or leave blank for Offline Deterministic)
# -----------------------------------------------------------------------------

# OPTION 1: Google Gemini (FREE via Google AI Studio - 15 RPM, 1,500 req/day)
# Get free key(s): https://aistudio.google.com/app/apikey
# Single key or MULTI-KEY ROTATION (separated by commas for automatic 429 failover):
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3
# GEMINI_API_KEY=your_single_gemini_key

# OPTION 2: Groq Cloud (100% FREE, Ultra-fast 500+ tokens/sec)
# Get free key: https://console.groq.com/keys
# GROQ_API_KEYS=gsk_your_key_1,gsk_your_key_2
# GROQ_API_KEY=gsk_your_groq_key

# OPTION 3: OpenRouter (Free open models)
# Get free key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your-key

# OPTION 4: OpenAI (Paid credits required)
# OPENAI_API_KEY=sk-proj-your-key

# Explicit provider override (gemini | groq | openrouter | openai | offline)
# LLM_PROVIDER=gemini
